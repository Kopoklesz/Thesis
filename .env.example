# Adatbázis kapcsolat
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pannonshop
DB_PASSWORD=valts-le-egy-eros-jelszora
DB_NAME=pannonshop

# JWT aláíró kulcs — éles környezetben erős, véletlenszerű értéket adj meg!
JWT_SECRET=valts-le-egy-eros-veletlen-kulcsra

PORT=3001
NODE_ENV=development

# Nyilvános referencia mód: true esetén a fiókkezelő műveletek
# (regisztráció, jelszóváltoztatás, felhasználó törlés/módosítás) le vannak
# zárva, és csak a seedelt minta fiókokkal lehet belépni.
REFERENCE_MODE=false

# Docker Compose-hoz: a frontend build-time beállításai
REACT_APP_API_URL=http://localhost:8091
REACT_APP_REFERENCE_MODE=true
